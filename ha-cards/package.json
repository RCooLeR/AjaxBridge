{
  "name": "ha-cards",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "check": "tsc -b",
    "test": "node --test test/*.test.mjs",
    "lint": "oxlint --type-aware --max-warnings 0 src vite.config.ts",
    "lint:fix": "oxlint --type-aware --fix src vite.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rolldown": "^1.2.12",
    "typescript": "~7.0.2",
    "vite": "^8.3.2"
  }
}
