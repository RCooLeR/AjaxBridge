{
  "name": "ha-cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "check": "tsc -b",
    "test": "node --test test/*.test.mjs",
    "lint": "oxlint --type-aware --max-warnings 0 src vite.config.ts",
    "lint:fix": "oxlint --type-aware --fix src vite.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
